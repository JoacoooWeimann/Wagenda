generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Priority {
  baja
  normal
  alta
}

enum GoalType {
  academico
  fisico
  videojuego
  profesional
}

enum PlanStrategy {
  divisible
  fases
}

// tarea: tarea común o unidad de un plan · sesion: sesión registrada de un
// objetivo por fases · hito: marca de fecha límite (no cuenta para la cuota)
enum TaskKind {
  tarea
  sesion
  hito
}

// activo: en curso (aunque haya pasado la fecha límite) · logrado / abandonado:
// cerrado por el usuario. Cerrar es reversible y no borra nada.
enum GoalStatus {
  activo
  logrado
  abandonado
}

// username y passwordHash son opcionales solo por el invitado (id 1, del seed):
// no tiene credenciales hasta que la primera cuenta registrada lo reclama.
model User {
  id           Int     @id @default(autoincrement())
  name         String  @default("Invitado") // nombre visible
  username     String? @unique              // para loguearse; en minúsculas
  passwordHash String?                      // scrypt, ver utiles/auth/password.js
  sessions     Session[]
  tasks    Task[]
  goals    Goal[]
  trackers Tracker[]
  items    TrackerItem[]
  groups   GroupMember[]
  joins    ShareJoin[]
  windows  DayWindow[]
  routine  RoutineBlock[]
}

model Goal {
  id          Int          @id @default(autoincrement())
  title       String
  description String?
  type        GoalType
  strategy    PlanStrategy
  startDate   DateTime
  deadline    DateTime
  status      GoalStatus   @default(activo)
  closedAt    DateTime?
  // Los parámetros de generación (contenidos, sesiones por semana, repaso) no se
  // guardan: el plan es editable, así que la fuente de verdad son sus semanas y tareas.
  createdAt   DateTime     @default(now())

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
  weeks  GoalWeek[]

  // Ítem de un seguimiento (opcional, ej. Gimnasio › Press banca): al registrar
  // una sesión se puede cargar también una medición, y la sesión suma actividad.
  // SetNull: borrar el ítem no borra el objetivo.
  item   TrackerItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemId Int?

  @@index([userId])
}

model GoalWeek {
  id        Int      @id @default(autoincrement())
  number    Int // 1, 2, 3...
  startDate DateTime
  endDate   DateTime
  label     String // "Unidades 3–4", "Repaso", "Consistencia"...
  target    Int // cuota de la semana: sesiones (fases) o tareas del plan (divisible)

  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  goalId Int
  tasks  Task[]

  @@unique([goalId, number])
}

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  done        Boolean  @default(false)
  priority    Priority @default(normal)
  kind        TaskKind @default(tarea)
  // Solo la completa el sistema en las tareas de un objetivo (su tipo, ej.
  // "Académico"). Para clasificar sus tareas, el usuario elige un seguimiento.
  category    String?
  // Horario opcional, solo en tareas de un día: minutos desde las 00:00
  // (los dos o ninguno). Una tarea sin horario va a "Sin horario" en la agenda.
  startMinute Int?
  endMinute   Int?
  createdAt   DateTime @default(now())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  // Solo las tareas generadas por un objetivo; el objetivo se llega vía la semana.
  // Cascade: si se borra el objetivo (y con él sus semanas), se borran sus tareas.
  goalWeek   GoalWeek? @relation(fields: [goalWeekId], references: [id], onDelete: Cascade)
  goalWeekId Int?

  // Seguimiento al que suma actividad (opcional, ej. Facultad) y, dentro de él,
  // el ítem (opcional, ej. Lógica). Si hay ítem, el seguimiento es el del ítem
  // (lo verifica el controller). SetNull: borrar cualquiera no borra la tarea.
  tracker   Tracker?     @relation(fields: [trackerId], references: [id], onDelete: SetNull)
  trackerId Int?
  item      TrackerItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemId    Int?

  @@index([goalWeekId])
  @@index([trackerId])
  @@index([itemId])
  // Cubre la consulta del mes (userId = ? AND startDate < ? ORDER BY startDate)
  // y, por empezar con userId, también las búsquedas por la foreign key
  @@index([userId, startDate])
}


// Tipo de un ítem. medicion: valores con fecha (press banca en kg, nota de un
// parcial) · actividad: cuenta las tareas hechas vinculadas. Los dos aceptan tareas.
enum TrackerKind {
  medicion
  actividad
}

// Seguimiento: un área que se sigue en el tiempo, sin fecha límite (ej.
// "Gimnasio", "Facultad", "Trabajo"). Adentro tiene ítems (ejercicios,
// materias, proyectos) y suma la actividad de las tareas vinculadas.
// Es lo que se comparte con un grupo de amigos.
model Tracker {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  itemLabel   String?  // cómo se llaman sus ítems: "Ejercicio", "Materia"…
  createdAt   DateTime @default(now())

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
  items  TrackerItem[]
  tasks  Task[]        // tareas vinculadas: su cantidad hecha es la "actividad"
  shares TrackerShare[]
  routine RoutineBlock[]

  // Copia de un seguimiento compartido al que el usuario se unió. Mientras está
  // vinculada, su estructura la define el dueño del original. SetNull: si el
  // original desaparece, la copia queda como seguimiento personal, con sus datos.
  sourceTracker   Tracker?  @relation("TrackerCopies", fields: [sourceTrackerId], references: [id], onDelete: SetNull)
  sourceTrackerId Int?
  copies          Tracker[] @relation("TrackerCopies")

  @@index([userId])
  @@index([sourceTrackerId])
}

// Ítem de un seguimiento: un ejercicio, una materia, un proyecto. De medición
// (valores con fecha: press banca en kg, nota de un parcial) o de actividad
// (cuenta las tareas hechas vinculadas). Cascade: es parte del seguimiento.
model TrackerItem {
  id             Int         @id @default(autoincrement())
  name           String
  kind           TrackerKind @default(medicion)
  unit           String?
  higherIsBetter Boolean     @default(true) // en "5 km" (minutos), menos es mejor
  createdAt      DateTime    @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  tracker   Tracker        @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  trackerId Int
  entries   TrackerEntry[]
  goals     Goal[]
  tasks     Task[]

  // Copia vinculada a un ítem de un seguimiento compartido (ver Tracker.sourceTrackerId)
  sourceItem   TrackerItem?  @relation("ItemCopies", fields: [sourceItemId], references: [id], onDelete: SetNull)
  sourceItemId Int?
  copies       TrackerItem[] @relation("ItemCopies")

  @@index([userId])
  @@index([trackerId])
  @@index([sourceItemId])
}

model TrackerEntry {
  id        Int      @id @default(autoincrement())
  date      DateTime // fecha de calendario (medianoche UTC), como las tareas
  value     Float
  note      String?
  createdAt DateTime @default(now())

  item   TrackerItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId Int

  // Historial de un ítem ordenado por fecha
  @@index([itemId, date])
}

// Sesión iniciada. La cookie lleva un token aleatorio; acá se guarda solo su
// hash (SHA-256): si se filtrara la base, los tokens no sirven para entrar.
// Cerrar sesión es borrar la fila.
model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  @@index([userId])
}

// --- Grupos -----------------------------------------------------------------
// Un grupo de amigos. Se entra con el código de invitación. Entrar no comparte
// nada: cada miembro elige a qué seguimientos compartidos unirse.

enum GroupRole {
  owner // el creador (o a quien se lo transfirió): administra el grupo
  member
}

model Group {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  inviteCode  String   @unique
  // Anti-spam: el grupo solo toma en cuenta los primeros N registros por
  // semana de cada persona en cada seguimiento. null = sin límite.
  weeklyLimit Int?
  createdAt   DateTime @default(now())

  members GroupMember[]
  shares  TrackerShare[]
}

model GroupMember {
  id       Int       @id @default(autoincrement())
  role     GroupRole @default(member)
  joinedAt DateTime  @default(now())

  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId Int
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  Int

  @@unique([groupId, userId])
  @@index([userId])
}

// Un seguimiento (original, nunca una copia) compartido en un grupo
model TrackerShare {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  group     Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   Int
  tracker   Tracker     @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  trackerId Int
  joins     ShareJoin[]

  @@unique([groupId, trackerId])
  @@index([trackerId])
}

// "Unirme": el usuario participa del seguimiento compartido EN ESTE grupo (si el
// mismo seguimiento está en otro grupo, ahí no aparece salvo que se una también)
model ShareJoin {
  id       Int      @id @default(autoincrement())
  joinedAt DateTime @default(now())

  share   TrackerShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  shareId Int
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  Int

  @@unique([shareId, userId])
  @@index([userId])
}

// --- Mi semana ----------------------------------------------------------------
// Horarios en minutos desde las 00:00 (540 = 09:00), en la hora local del
// usuario, como las fechas de calendario. Nada cruza la medianoche (máx. 1440).
// weekday: 0 = lunes … 6 = domingo, como las semanas de la app.

// Franja activa de un día de la semana ("los lunes estoy disponible de 7 a 23").
// Si un día no tiene, se usa la franja por defecto (utiles/schedule/slots.js).
model DayWindow {
  id          Int @id @default(autoincrement())
  weekday     Int
  startMinute Int
  endMinute   Int

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  @@unique([userId, weekday])
}

// Bloque fijo de la rutina semanal: "Trabajo", lunes de 9:00 a 17:00. Puede
// vincularse a un seguimiento (toma su nombre y color). SetNull: borrar el
// seguimiento no borra el bloque.
model RoutineBlock {
  id          Int      @id @default(autoincrement())
  weekday     Int
  startMinute Int
  endMinute   Int
  title       String
  createdAt   DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  tracker   Tracker? @relation(fields: [trackerId], references: [id], onDelete: SetNull)
  trackerId Int?

  @@index([userId, weekday])
}
