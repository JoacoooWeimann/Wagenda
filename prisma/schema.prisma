generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Priority {
  baja
  normal
  alta
}

enum GoalType {
  academico
  fisico
  videojuego
  profesional
}

enum PlanStrategy {
  divisible
  fases
}

// tarea: tarea común o unidad de un plan · sesion: sesión registrada de un
// objetivo por fases · hito: marca de fecha límite (no cuenta para la cuota)
enum TaskKind {
  tarea
  sesion
  hito
}

// activo: en curso (aunque haya pasado la fecha límite) · logrado / abandonado:
// cerrado por el usuario. Cerrar es reversible y no borra nada.
enum GoalStatus {
  activo
  logrado
  abandonado
}

model User {
  id    Int    @id @default(autoincrement())
  name  String @default("Invitado")
  tasks    Task[]
  goals    Goal[]
  trackers Tracker[]
  boards   Board[]
}

model Goal {
  id          Int          @id @default(autoincrement())
  title       String
  description String?
  type        GoalType
  strategy    PlanStrategy
  startDate   DateTime
  deadline    DateTime
  status      GoalStatus   @default(activo)
  closedAt    DateTime?
  // Los parámetros de generación (contenidos, sesiones por semana, repaso) no se
  // guardan: el plan es editable, así que la fuente de verdad son sus semanas y tareas.
  createdAt   DateTime     @default(now())

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
  weeks  GoalWeek[]

  // Seguimiento opcional: al registrar una sesión se puede cargar también una
  // medición. SetNull: borrar el seguimiento no borra el objetivo.
  tracker   Tracker? @relation(fields: [trackerId], references: [id], onDelete: SetNull)
  trackerId Int?

  @@index([userId])
}

model GoalWeek {
  id        Int      @id @default(autoincrement())
  number    Int // 1, 2, 3...
  startDate DateTime
  endDate   DateTime
  label     String // "Unidades 3–4", "Repaso", "Consistencia"...
  target    Int // cuota de la semana: sesiones (fases) o tareas del plan (divisible)

  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  goalId Int
  tasks  Task[]

  @@unique([goalId, number])
}

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  done        Boolean  @default(false)
  priority    Priority @default(normal)
  kind        TaskKind @default(tarea)
  category    String?
  createdAt   DateTime @default(now())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  // Solo las tareas generadas por un objetivo; el objetivo se llega vía la semana.
  // Cascade: si se borra el objetivo (y con él sus semanas), se borran sus tareas.
  goalWeek   GoalWeek? @relation(fields: [goalWeekId], references: [id], onDelete: Cascade)
  goalWeekId Int?

  @@index([goalWeekId])
  // Cubre la consulta del mes (userId = ? AND startDate < ? ORDER BY startDate)
  // y, por empezar con userId, también las búsquedas por la foreign key
  @@index([userId, startDate])
}

// Tablero: agrupa seguimientos relacionados (ej. "Gimnasio": press banca,
// sentadilla; "CS2": rating, K/D). Más adelante es lo que se comparte con un
// grupo de amigos, y cada miembro elige si se une.
model Board {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   Int
  trackers Tracker[]

  @@index([userId])
}

// Algo que se mide en el tiempo, sin fecha límite (ej. "Press banca" en kg,
// "Rating Premier" en pts). Un objetivo mide constancia (sesiones y cuotas);
// un seguimiento mide rendimiento. Es lo que más adelante se comparte en grupos.
model Tracker {
  id             Int       @id @default(autoincrement())
  name           String
  unit           String?
  higherIsBetter Boolean   @default(true) // en "5 km" (minutos), menos es mejor
  createdAt      DateTime  @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  Int
  entries TrackerEntry[]
  goals   Goal[]

  // Tablero opcional (uno solo). SetNull: borrar un tablero no borra sus
  // seguimientos ni sus registros; pasan a "Sin tablero".
  board   Board? @relation(fields: [boardId], references: [id], onDelete: SetNull)
  boardId Int?

  @@index([userId])
  @@index([boardId])
}

model TrackerEntry {
  id        Int      @id @default(autoincrement())
  date      DateTime // fecha de calendario (medianoche UTC), como las tareas
  value     Float
  note      String?
  createdAt DateTime @default(now())

  tracker   Tracker @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  trackerId Int

  // Historial de un seguimiento ordenado por fecha
  @@index([trackerId, date])
}
