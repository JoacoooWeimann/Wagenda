# Copiar como .env y ajustar

# Base SQLite. En desarrollo, relativa a prisma/; en Railway, en el volumen:
#   DATABASE_URL="file:/data/wagenda.db"
DATABASE_URL="file:./dev.db"

# Opcional (por defecto 3000; Railway lo define solo)
# PORT=3000

# En producción: production (cookie Secure, sin logs de cada pedido)
# NODE_ENV=production

# Proxies delante de la app (por defecto 1 en producción, 0 en desarrollo)
# TRUST_PROXY=1

# Backups diarios: carpeta (por defecto prisma/backups o, con ruta absoluta,
# "backups" junto a la base) y cuántos días se guardan (por defecto 7)
# BACKUP_DIR=/data/backups
# BACKUP_KEEP=7
