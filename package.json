{
  "name": "wagenda",
  "version": "1.1.0",
  "description": "Agenda y calendario personal con planificación de objetivos",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "build": "vite build",
    "watch:client": "vite build --watch",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "setup": "prisma generate && prisma migrate deploy && prisma db seed && vite build",
    "test": "node --test \"test/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" \"test/**/*.test.js\""
  },
  "nodemonConfig": {
    "ignore": [
      "src/client/",
      "src/public/"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "morgan": "^1.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "dotenv": "^16.6.1",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3",
    "vite": "^8.2.2"
  }
}
