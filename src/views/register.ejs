<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/navigation') %>

  <main class="container min-vh-100 d-flex justify-content-center align-items-center py-5">
    <div class="card auth-card shadow">
      <div class="card-body p-4">
        <h1 class="h3 mb-4 text-center">Crear cuenta</h1>
        <% if (error) { %><div class="alert alert-danger py-2" role="alert"><%= error %></div><% } %>

        <form method="post" action="/register" novalidate>
          <input type="hidden" name="next" value="<%= next %>">
          <%- include('partials/auth-field', { name: 'name', label: 'Nombre', type: 'text', value: values.name ?? '', error: fields.name, autocomplete: 'name', hint: 'Es el que ven tus amigos.' }) %>
          <%- include('partials/auth-field', { name: 'username', label: 'Usuario', type: 'text', value: values.username ?? '', error: fields.username, autocomplete: 'username', hint: '3 a 20 caracteres: letras, números y guion bajo.' }) %>
          <%- include('partials/auth-field', { name: 'password', label: 'Contraseña', type: 'password', value: '', error: fields.password, autocomplete: 'new-password', hint: 'Mínimo 8 caracteres.' }) %>
          <%- include('partials/auth-field', { name: 'passwordConfirm', label: 'Repetir contraseña', type: 'password', value: '', error: fields.passwordConfirm, autocomplete: 'new-password' }) %>
          <button type="submit" class="btn btn-primary w-100">Crear cuenta</button>
        </form>

        <p class="text-center mt-3 mb-0">¿Ya tenés cuenta? <a href="/login?next=<%= encodeURIComponent(next) %>">Ingresá</a></p>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
