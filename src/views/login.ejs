<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/navigation') %>

  <main class="container min-vh-100 d-flex justify-content-center align-items-center py-5">
    <div class="card auth-card shadow">
      <div class="card-body p-4">
        <h1 class="h3 mb-4 text-center">Ingresar</h1>
        <% if (error) { %><div class="alert alert-danger py-2" role="alert"><%= error %></div><% } %>

        <form method="post" action="/login" novalidate>
          <input type="hidden" name="next" value="<%= next %>">
          <%- include('partials/auth-field', { name: 'username', label: 'Usuario', type: 'text', value: values.username ?? '', error: fields.username, autocomplete: 'username' }) %>
          <%- include('partials/auth-field', { name: 'password', label: 'Contraseña', type: 'password', value: '', error: fields.password, autocomplete: 'current-password' }) %>
          <button type="submit" class="btn btn-primary w-100">Ingresar</button>
        </form>

        <p class="text-center mt-3 mb-0">¿No tenés cuenta? <a href="/register?next=<%= encodeURIComponent(next) %>">Creá una</a></p>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
