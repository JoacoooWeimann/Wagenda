<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/navigation') %>

  <header class="container min-vh-100 d-flex justify-content-center align-items-center text-light">
    <div class="d-flex flex-column justify-content-center align-items-center text-center">
      <img src="/img/logo.png" alt="Logo de Wagenda" class="w-25">
      <h1 class="display-1 my-5 fw-bold">Wagenda</h1>
      <p class="lead">Tu agenda personal: tareas, objetivos con plan semanal y seguimiento de tu progreso.</p>
      <% if (locals.user) { %>
        <a href="/calendar" class="btn btn-primary btn-lg mt-4">Ir al calendario</a>
      <% } else { %>
        <div class="d-flex gap-3 mt-4">
          <a href="/register" class="btn btn-primary btn-lg">Crear cuenta</a>
          <a href="/login" class="btn btn-outline-light btn-lg">Ingresar</a>
        </div>
      <% } %>
    </div>
  </header>

  <%- include('partials/footer') %>
</body>
</html>
