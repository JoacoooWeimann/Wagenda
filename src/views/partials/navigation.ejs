<%
  // Las secciones con datos solo se muestran con sesión
  const links = !locals.user ? [{ href: '/', label: 'Inicio' }] : [
    { href: '/', label: 'Inicio' },
    { href: '/calendar', label: 'Calendario' },
    { href: '/goals', label: 'Objetivos' },
    { href: '/trackers', label: 'Seguimientos' },
    { href: '/groups', label: 'Grupos' }
  ];
%>
<nav class="navbar navbar-expand-lg bg-body-tertiary" data-bs-theme="dark">
  <div class="container-fluid">
    <a class="navbar-brand" href="/">Wagenda</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarLinks" aria-controls="navbarLinks" aria-expanded="false" aria-label="Abrir menú">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarLinks">
      <div class="navbar-nav">
        <% links.forEach(link => { const active = currentPath === link.href; %>
          <a class="nav-link<%= active ? ' active' : '' %>" href="<%= link.href %>"<%- active ? ' aria-current="page"' : '' %>><%= link.label %></a>
        <% }) %>
      </div>
      <%# Sesión: el usuario lo deja en res.locals el middleware loadUser %>
      <div class="navbar-nav ms-auto align-items-lg-center">
        <% if (locals.user) { %>
          <span class="navbar-text me-lg-3"><%= user.name %> <small class="text-secondary">@<%= user.username %></small></span>
          <form method="post" action="/logout" class="d-inline">
            <button type="submit" class="btn btn-link nav-link">Salir</button>
          </form>
        <% } else { %>
          <a class="nav-link<%= currentPath === '/login' ? ' active' : '' %>" href="/login">Ingresar</a>
          <a class="nav-link<%= currentPath === '/register' ? ' active' : '' %>" href="/register">Crear cuenta</a>
        <% } %>
      </div>
    </div>
  </div>
</nav>
